FROM composer:2.10.3@sha256:da624c2c705d54e2f5a9bb77a5dc6c7d091711433ebefd7035672e84c2010fee AS composer

FROM php:8.3.36-fpm-bookworm@sha256:6b4641a875dd3e0f7551b2751e1f5909084856d18166af7fbb522ac230feb702

RUN apt-get update && apt-get install -y --no-install-recommends \
    build-essential \
    default-mysql-client \
    libpng-dev \
    libjpeg62-turbo-dev \
    libfreetype6-dev \
    libmagickwand-dev \
    libzip-dev \
    libsqlite3-dev \
    libonig-dev \
    libc-client-dev \
    libkrb5-dev \
    locales \
    zip unzip\
    git \
    supervisor \
    jpegoptim optipng pngquant gifsicle && apt-get clean

RUN docker-php-ext-install pdo pdo_mysql pdo_sqlite mbstring zip exif pcntl bcmath opcache fileinfo iconv

RUN docker-php-ext-configure imap --with-kerberos --with-imap-ssl && docker-php-ext-install imap

# Use the default production configuration
RUN mv "$PHP_INI_DIR/php.ini-production" "$PHP_INI_DIR/php.ini"

# Override with custom opcache settings
COPY config/phpcustom.ini $PHP_INI_DIR/conf.d/

# Installing composer
COPY --from=composer /usr/bin/composer /usr/local/bin/composer

WORKDIR /backend

RUN chown -R www-data:www-data /backend/ && chmod -R 777 /backend/

COPY ./config/supervisord.conf /etc/supervisor
